# ---------------------------------------------------------------------------
# CollegeEvents Backend (Node.js/Express) — Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit .env to version control.
# ---------------------------------------------------------------------------

# ── Application Environment ──────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ── Primary Database (MongoDB) ────────────────────────────────────────────────
# Use a local MongoDB instance or MongoDB Atlas replica set URI
MONGODB_URI=mongodb://localhost:27017/event_booking_db

# ── JWT Authentication ───────────────────────────────────────────────────────
# Access token secret (minimum 32 characters required in production)
JWT_SECRET=development-jwt-secret-key-must-be-at-least-32-chars-long
JWT_EXPIRES_IN=30m
# Refresh token secret (minimum 32 characters required in production)
JWT_REFRESH_SECRET=development-refresh-secret-key-must-be-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d
# Optional first-run President provisioning; no default account is created without both values.
PRESIDENT_EMAIL=
PRESIDENT_PASSWORD=
PRESIDENT_NAME=Association President

# ── Payment Gateway (Razorpay - Placeholders) ──────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_CURRENCY=INR

# ── AI Provider (Google Gemini - Placeholders) ────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# ── Mail Configuration (SMTP - Placeholders) ──────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_16chars
