# ---------------------------------------------------------------------------
# CollegeEvents — Unified Environment Configuration Template
# Target Architecture: Node.js/Express + MongoDB + React/Vite
#
# Copy this file to .env and configure your values.
# NEVER commit .env to version control.
# ---------------------------------------------------------------------------

# ── Target Runtime: Node.js / Express Backend (backend-node) ────────────────
NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ── Primary Database (MongoDB) ──────────────────────────────────────────────
# Local MongoDB instance or MongoDB Atlas replica set URI
MONGODB_URI=mongodb://localhost:27017/event_booking_db

# ── JWT Authentication ─────────────────────────────────────────────────────
# Minimum 32 characters required in production
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=replace-with-a-refresh-secret-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d
# Optional first-run President provisioning. Leave blank to provision through an administrative workflow.
PRESIDENT_EMAIL=
PRESIDENT_PASSWORD=
PRESIDENT_NAME=Association President

# ── Payment Gateway (Razorpay) ──────────────────────────────────────────────
# Test keys from https://dashboard.razorpay.com/app/keys (starts with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_CURRENCY=INR

# ── AI Provider (Google Gemini & EventGPT) ─────────────────────────────────
# API key from https://aistudio.google.com/app/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# ── Mail Configuration (SMTP) ──────────────────────────────────────────────
# 16-character Google App Password from Google Account Security
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ===========================================================================
# Legacy Stack Settings (Retained for Java/MySQL Historical Reference)
# ===========================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=event_booking_db
DB_USERNAME=root
DB_PASSWORD=YOUR_DATABASE_PASSWORD
MONGODB_ENABLED=false
VECTOR_DB_PROVIDER=mysql
